# Cloudflare R2 图床凭据模板
#
# 用法：把本文件复制成 .env，再填入下面 5 个值：
#   cp .env.example .env        （或在资源管理器里复制一份并改名为 .env）
#
# .env 已被 .gitignore 忽略，绝不会进版本库；.env.example 本身不含任何密钥，可以提交。
# 取值步骤见 docs/R2-IMAGE-HOST.md「配置步骤」。
# 填完后自检：python scripts/check-r2-config.py

# 1) Cloudflare 控制台右侧栏的 Account ID（32 位十六进制）
R2_ACCOUNT_ID=

# 2) Manage R2 API Tokens → Create Account API token（权限 Object Read & Write）
R2_ACCESS_KEY_ID=

# 3) 上一步只显示一次的 Secret Access Key
R2_SECRET_ACCESS_KEY=

# 4) 桶名，默认即可
R2_BUCKET=blog-photos

# 5) 桶 → Settings → Public access 开启 r2.dev 后显示的公开域名，末尾不要带 /
R2_PUBLIC_BASE=
