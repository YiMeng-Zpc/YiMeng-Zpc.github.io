{
  "name": "yimeng-blog",
  "version": "1.0.0",
  "private": true,
  "description": "忆梦的博客 - Hugo + Keystatic CMS",
  "scripts": {
    "dev": "hugo server --bind=0.0.0.0",
    "dev:keystatic": "next dev -p 3000",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:keystatic\"",
    "build": "hugo --minify",
    "preview": "hugo server --bind=0.0.0.0 -D"
  },
  "dependencies": {
    "@keystatic/core": "^0.5.0",
    "@keystatic/hugo": "^0.1.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "concurrently": "^8.2.0",
    "typescript": "^5.3.0"
  }
}
